# PostgreSQL + pgvector (docker compose up -d db)
POSTGRES_DB=potrebkonsult
POSTGRES_USER=potreb
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://potreb:change-me@localhost:5432/potrebkonsult

# Ollama: модель эмбеддингов BGE-M3 (ollama pull bge-m3)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120

# Отдельная БД для интеграционных тестов (без неё они пропускаются)
TEST_DATABASE_URL=postgresql+asyncpg://potreb:change-me@localhost:5432/potrebkonsult_test
